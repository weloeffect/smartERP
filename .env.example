# Copy to .env using `uv run python -m app.cli configure` (creates a random internal token).
DASHSCOPE_API_KEY=
# Singapore pay-as-you-go. Match the endpoint to the region and plan used to create your API key.
QWEN_BASE_URL=https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_COMPLETION_TOKENS=4096
QWEN_ENABLE_THINKING=false
CHAT_TIMEOUT_SECONDS=180
# For Token Plan, use https://token-plan.maas.qwencloudapi.com/compatible-mode/v1 and its own key.
# QWEN_API_KEY is also accepted and takes precedence when present.
INTERNAL_TOKEN=replace-with-a-random-token-of-at-least-32-characters
ERP_URL=http://127.0.0.1:8001
WEB_ORIGIN=http://127.0.0.1:8000
# Optional: separate local account database (salted password hashes; never plaintext).
# AUTH_DATABASE_PATH=C:/path/to/auth.sqlite
# Optional: absolute SQLite URL. Default: <project>/data/erp.sqlite
# DATABASE_URL=sqlite:///C:/path/to/erp.sqlite

